# Neon Postgres connection string. Get it from https://console.neon.tech
# (the "Pooled connection" string is what you want for serverless / edge).
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Optional — used for absolute URLs in metadata + sitemap. Falls back to mcpkit.vercel.app.
# NEXT_PUBLIC_SITE_URL="https://mcpkit.vercel.app"
