# Neon Postgres connection string. Get it from https://console.neon.tech
# (the "Pooled connection" string is what you want for serverless / edge).
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Optional — used for absolute URLs in metadata + sitemap. Falls back to mcpkit.vercel.app.
# NEXT_PUBLIC_SITE_URL="https://mcpkit.vercel.app"

# Clerk authentication. Get both from https://dashboard.clerk.com
#   → your application → API Keys
# Use the "Quickstart" or "Show API keys" section. Test keys start with pk_test_ / sk_test_;
# production keys start with pk_live_ / sk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"

# Optional — override Clerk's default redirect targets after sign-in / sign-up.
# Defaults to "/" if not set.
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Clerk webhook signing secret. Get from https://dashboard.clerk.com
#   → your application → Webhooks → click the endpoint you created → "Signing Secret".
# Starts with whsec_. Used by /api/webhooks/clerk to verify svix signatures.
CLERK_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Stripe — get keys from https://dashboard.stripe.com/test/apikeys
# Test mode keys start with sk_test_ / pk_test_; production with sk_live_ / pk_live_.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"

# Stripe webhook signing secret. https://dashboard.stripe.com/test/webhooks
#   → click your endpoint → "Signing secret". Starts with whsec_.
# (Different secret than CLERK_WEBHOOK_SECRET.)
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Stripe price IDs. Create products in Stripe (dashboard → Products), add a
# recurring monthly price to each, then paste the price IDs here. Each starts
# with price_. Set metadata { plan_id: "pro" } / { plan_id: "team" } on each
# Stripe product as a backup for the env-based mapping.
STRIPE_PRICE_PRO="price_REPLACE_ME"
STRIPE_PRICE_TEAM="price_REPLACE_ME"
